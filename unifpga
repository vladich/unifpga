#!/usr/bin/env python3
"""The unifpga command (tools/cli.py), run with a Python that has what it needs.

It needs Python 3 with the packages of requirements.txt (PyYAML, jsonschema).
The interpreter that starts it is used when it has them. Otherwise the
repository's own virtual environment, .venv, is used: made on first use with
the requirements — by this interpreter, or the first python3 that can make one
with pip — and kept complete on every later run (a missing package is
installed into it). Nothing is ever installed into a Python of yours.
UNIFPGA_PYTHON names an interpreter to run with instead; it must have the
packages. ./serve.sh starts the editor through this same launcher.
"""
import importlib.util
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
MODULES = ("yaml", "jsonschema")                        # requirements.txt, by import name
VENV = os.path.join(HERE, ".venv")
VENV_PYTHON = os.path.join(VENV, "Scripts", "python.exe") if os.name == "nt" else os.path.join(VENV, "bin", "python")
MADE_HERE = os.path.join(VENV, ".unifpga-ready")        # a .venv the launcher made: it may be made again
HOP = "UNIFPGA_BOOTSTRAP"                               # set on the re-exec into .venv: no second hop
CANDIDATES = ("python3", "python3.13", "python3.12", "python3.11", "python3.10", "python3.9", "/usr/bin/python3")


def say(text):
    sys.stderr.write("unifpga: " + text + "\n")


def missing_here():
    return [m for m in MODULES if importlib.util.find_spec(m) is None]


def missing_for(python):
    """The modules `python` cannot import — all of them when it cannot run."""
    probe = "import importlib.util, sys; print(' '.join(m for m in sys.argv[1:] if importlib.util.find_spec(m) is None))"
    try:
        out = subprocess.run([python, "-c", probe] + list(MODULES), capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return list(MODULES)
    return out.stdout.split() if out.returncode == 0 else list(MODULES)


def install_requirements(python):
    """requirements.txt into `python`; True when every module imports afterwards."""
    done = subprocess.run([python, "-m", "pip", "install", "--quiet", "-r", os.path.join(HERE, "requirements.txt")],
                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return done.returncode == 0 and not missing_for(python)


def make_venv():
    """A fresh .venv with the requirements, by the first interpreter that can; True when one could."""
    seen = set()
    for candidate in (sys.executable,) + CANDIDATES:
        path = candidate if os.path.isabs(candidate) else shutil.which(candidate)
        if not path or os.path.realpath(path) in seen:
            continue
        seen.add(os.path.realpath(path))
        shutil.rmtree(VENV, ignore_errors=True)
        say("making .venv with {} and requirements.txt".format(path))
        made = subprocess.run([path, "-m", "venv", VENV], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
        if made and install_requirements(VENV_PYTHON):
            open(MADE_HERE, "w").close()
            return True
        say("{} could not make a virtual environment with the requirements; trying the next".format(path))
    shutil.rmtree(VENV, ignore_errors=True)
    return False


def python_to_use():
    """The interpreter to run with, or None when the running one has the packages."""
    if not missing_here():
        return None
    chosen = os.environ.get("UNIFPGA_PYTHON")
    if chosen:
        lacking = missing_for(chosen)
        if lacking:
            sys.exit("unifpga: UNIFPGA_PYTHON={} lacks {}; install the requirements for it:\n"
                     "        {} -m pip install -r requirements.txt".format(chosen, ", ".join(lacking), chosen))
        return chosen
    if os.path.exists(VENV_PYTHON):
        lacking = missing_for(VENV_PYTHON)
        if lacking:
            say(".venv lacks {}; installing requirements.txt into it".format(", ".join(lacking)))
            if not install_requirements(VENV_PYTHON):
                if not os.path.exists(MADE_HERE):
                    sys.exit("unifpga: the install into .venv failed and .venv is not one this launcher made; fix it or remove it.")
                say("the install failed; making .venv again")
                if not make_venv():
                    sys.exit(_no_python())
        return VENV_PYTHON
    if not make_venv():
        sys.exit(_no_python())
    return VENV_PYTHON


def _no_python():
    return ("unifpga: no Python 3 with the requirements ({}), and none could make a virtual environment with pip.\n"
            "        Install them for a Python of yours (python3 -m pip install -r requirements.txt) or set UNIFPGA_PYTHON=<interpreter>."
            .format(", ".join(MODULES)))


def main():
    python = python_to_use()
    if python is None:
        sys.path.insert(0, HERE)
        from tools.cli import main as cli_main
        return cli_main()
    if os.environ.get(HOP) and os.path.realpath(python) == os.path.realpath(sys.executable):
        sys.exit("unifpga: {} still lacks {} after installing requirements.txt".format(python, ", ".join(missing_here())))
    env = dict(os.environ)
    env[HOP] = "1"
    os.execve(python, [python, os.path.realpath(__file__)] + sys.argv[1:], env)


if __name__ == "__main__":
    sys.exit(main())
