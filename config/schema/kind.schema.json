{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unifpga:schema:kind",
  "title": "Device kinds",
  "description": "config/kinds.yml: the kinds a board's banks give their devices (the inventory's taxonomy), each with the features a board with such a bank lists one of; empty when the kind implies none.",
  "type": "object",
  "required": ["Kinds"],
  "additionalProperties": false,
  "properties": {
    "Kinds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/kind" } }
  },
  "$defs": {
    "kind": {
      "type": "object",
      "required": ["kind", "description", "features"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1 },
        "features": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$" } }
      }
    }
  }
}
